{
  "name": "liwuai-connect",
  "version": "1.0.0",
  "description": "AI-first social media management platform on Cloudflare free tier",
  "private": true,
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "dev": "pnpm --filter @liwuai/api dev --parallel --filter @liwuai/web dev",
    "deploy": "pnpm --filter @liwuai/api deploy && pnpm --filter @liwuai/web deploy",
    "db:generate": "pnpm --filter @liwuai/db generate",
    "db:migrate": "pnpm --filter @liwuai/api db:migrate",
    "db:push": "pnpm --filter @liwuai/api db:push"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
