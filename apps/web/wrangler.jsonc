{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "lywuaiconnect",
  "compatibility_date": "2024-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "pages_build_dir": "dist",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "liwuai-db",
      "database_id": "7d88619a-82cf-4f37-a472-d736c567e98a"
    }
  ],
  "vars": {
    "OPENROUTER_BASE_URL": "https://openrouter.ai/api/v1",
    "OPENROUTER_MODEL": "openrouter/free",
    "JWT_SECRET": "liwuai-connect-secure-jwt-secret-key-32chars"
  }
}
